{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.kronixon.com/protocol/v1/schemas/module/health.json",
  "title": "GET health",
  "description": "Cheap self-check without COUNT(*) queries (Spec §6.31, §11).",
  "x-kx-endpoint": {
    "method": "GET",
    "path": "/v1/health",
    "signed": true,
    "pr": "M1"
  },
  "$defs": {
    "response": {
      "type": "object",
      "required": [
        "ok",
        "server_time",
        "module_version",
        "paired",
        "store_id",
        "db_ok"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "server_time": { "$ref": "../common.json#/$defs/unix_time" },
        "module_version": { "type": "string" },
        "paired": { "type": "boolean" },
        "store_id": {
          "anyOf": [
            { "$ref": "../common.json#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "outbox": {
          "type": "object",
          "properties": {
            "pending": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "oldest_pending_at": {
              "$ref": "../common.json#/$defs/datetime_or_null"
            }
          }
        },
        "last_platform_request_at": {
          "$ref": "../common.json#/$defs/datetime_or_null"
        },
        "last_webhook_ok_at": {
          "$ref": "../common.json#/$defs/datetime_or_null"
        },
        "db_ok": { "type": "boolean" },
        "writable_dirs_ok": { "type": "boolean" },
        "php": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "examples": [
        {
          "ok": true,
          "server_time": 1790772000,
          "module_version": "1.0.0",
          "paired": true,
          "store_id": "0192b2e4-2f7a-7c5b-8a1d-3e4f5a6b7c8d",
          "outbox": {
            "pending": 12,
            "failed": 0,
            "oldest_pending_at": "2026-09-30T12:39:00Z"
          },
          "last_platform_request_at": "2026-09-30T12:39:50Z",
          "last_webhook_ok_at": "2026-09-30T12:38:00Z",
          "db_ok": true,
          "writable_dirs_ok": true,
          "php": { "version": "8.1.29", "memory_limit": "256M" },
          "warnings": ["cron_not_configured"]
        }
      ]
    }
  }
}
