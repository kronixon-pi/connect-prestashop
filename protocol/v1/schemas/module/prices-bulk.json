{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.kronixon.com/protocol/v1/schemas/module/prices-bulk.json",
  "title": "POST prices/bulk",
  "description": "Up to 1 000 net price rows without Product::save(); expected_price turns a manual change in the shop into status conflict and the row is not written (Spec §6.21). null = do not touch.",
  "x-kx-endpoint": {
    "method": "POST",
    "path": "/v1/prices/bulk",
    "signed": true,
    "pr": "M4"
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["product_id", "variant_id", "price"],
      "properties": {
        "product_id": { "$ref": "../common.json#/$defs/external_id" },
        "variant_id": { "$ref": "../common.json#/$defs/external_id" },
        "price": { "$ref": "../common.json#/$defs/money_or_null" },
        "wholesale_price": { "$ref": "../common.json#/$defs/money_or_null" },
        "tax_rules_group_id": { "type": ["integer", "null"], "minimum": 0 },
        "unit_price": { "$ref": "../common.json#/$defs/money_or_null" },
        "expected_price": { "$ref": "../common.json#/$defs/money_or_null" }
      }
    },
    "request": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "flush_cache": { "type": "boolean" },
            "fire_hooks": { "type": "boolean" },
            "touch_date_upd": { "type": "boolean" }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/row" }
        }
      },
      "examples": [
        {
          "options": {
            "flush_cache": true,
            "fire_hooks": false,
            "touch_date_upd": true
          },
          "rows": [
            {
              "product_id": "123",
              "variant_id": "0",
              "price": "99.990000",
              "wholesale_price": null,
              "tax_rules_group_id": null,
              "unit_price": null,
              "expected_price": "89.990000"
            }
          ]
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["results", "summary", "continue"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product_id", "variant_id", "status"],
            "properties": {
              "product_id": { "$ref": "../common.json#/$defs/external_id" },
              "variant_id": { "$ref": "../common.json#/$defs/external_id" },
              "status": { "enum": ["ok", "conflict", "error", "skipped"] },
              "previous_price": {
                "$ref": "../common.json#/$defs/money_or_null"
              },
              "current_price": {
                "$ref": "../common.json#/$defs/money_or_null"
              },
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "summary": {
          "$ref": "../common.json#/$defs/batch_response/properties/summary"
        },
        "continue": { "type": "boolean" },
        "retry_after": { "type": "integer", "minimum": 0 }
      },
      "examples": [
        {
          "results": [
            {
              "product_id": "123",
              "variant_id": "0",
              "status": "conflict",
              "previous_price": "95.000000",
              "current_price": "95.000000"
            }
          ],
          "summary": {
            "ok": 0,
            "error": 0,
            "skipped": 0,
            "conflict": 1,
            "time_ms": 9
          },
          "continue": false
        }
      ]
    }
  }
}
