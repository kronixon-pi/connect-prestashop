{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.kronixon.com/protocol/v1/schemas/module/rotate.json",
  "title": "POST rotate",
  "description": "Secret rotation, signed with the current secret: the new one arrives sealed to the module's X25519 key; the old one stays valid as prev until prev_valid_until (24 h). Idempotent by Idempotency-Key (Spec §4.3, §6.32).",
  "x-kx-endpoint": {
    "method": "POST",
    "path": "/v1/rotate",
    "signed": true,
    "pr": "M1"
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": ["secret_sealed", "prev_valid_until"],
      "properties": {
        "secret_sealed": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "maxLength": 256
        },
        "prev_valid_until": { "$ref": "../common.json#/$defs/unix_time" }
      },
      "examples": [
        {
          "secret_sealed": "c2VhbGVkLWJ5LWNyeXB0by1ib3gtc2VhbA==",
          "prev_valid_until": 1790858400
        }
      ]
    },
    "response": {
      "$ref": "../common.json#/$defs/ok_response",
      "examples": [{ "ok": true }]
    }
  }
}
