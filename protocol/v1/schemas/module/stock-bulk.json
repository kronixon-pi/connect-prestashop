{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.kronixon.com/protocol/v1/schemas/module/stock-bulk.json",
  "title": "POST stock/bulk",
  "description": "Up to 1 000 quantity rows; mode safe goes through StockAvailable::setQuantity (hooks, packs), fast writes stock_available directly; visibility_policy restores or hides products (Spec §6.22). location is always default for PrestaShop.",
  "x-kx-endpoint": {
    "method": "POST",
    "path": "/v1/stock/bulk",
    "signed": true,
    "pr": "M4"
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["product_id", "variant_id", "quantity"],
      "properties": {
        "product_id": { "$ref": "../common.json#/$defs/external_id" },
        "variant_id": { "$ref": "../common.json#/$defs/external_id" },
        "location": { "type": "string" },
        "shop_id": { "type": ["integer", "null"] },
        "quantity": { "type": "integer" },
        "out_of_stock": { "enum": [0, 1, 2, null] },
        "available_now": {
          "anyOf": [
            { "$ref": "../common.json#/$defs/multilang" },
            { "type": "null" }
          ]
        },
        "available_later": {
          "anyOf": [
            { "$ref": "../common.json#/$defs/multilang" },
            { "type": "null" }
          ]
        },
        "expected_quantity": { "type": ["integer", "null"] }
      }
    },
    "request": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["safe", "fast"] },
            "visibility_policy": {
              "enum": ["none", "restore_if_hidden", "hide_when_zero"]
            },
            "fire_hooks": { "type": "boolean" }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/row" }
        }
      },
      "examples": [
        {
          "options": {
            "mode": "safe",
            "visibility_policy": "restore_if_hidden",
            "fire_hooks": true
          },
          "rows": [
            {
              "product_id": "123",
              "variant_id": "0",
              "location": "default",
              "shop_id": null,
              "quantity": 7,
              "out_of_stock": null,
              "available_now": null,
              "available_later": null,
              "expected_quantity": null
            }
          ]
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["results", "summary", "continue"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product_id", "variant_id", "status"],
            "properties": {
              "product_id": { "$ref": "../common.json#/$defs/external_id" },
              "variant_id": { "$ref": "../common.json#/$defs/external_id" },
              "status": { "enum": ["ok", "conflict", "error", "skipped"] },
              "previous_quantity": { "type": ["integer", "null"] },
              "current_quantity": { "type": ["integer", "null"] },
              "code": { "type": "string" },
              "warnings": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "summary": {
          "$ref": "../common.json#/$defs/batch_response/properties/summary"
        },
        "continue": { "type": "boolean" },
        "retry_after": { "type": "integer", "minimum": 0 }
      },
      "examples": [
        {
          "results": [
            {
              "product_id": "123",
              "variant_id": "0",
              "status": "ok",
              "previous_quantity": 5
            }
          ],
          "summary": { "ok": 1, "error": 0, "skipped": 0, "time_ms": 12 },
          "continue": false,
          "retry_after": 0
        }
      ]
    }
  }
}
