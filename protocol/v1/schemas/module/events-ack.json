{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.kronixon.com/protocol/v1/schemas/module/events-ack.json",
  "title": "POST events/ack",
  "description": "Marks pulled events as sent (Spec §6.34). Unknown ids are ignored; acknowledging twice is harmless.",
  "x-kx-endpoint": {
    "method": "POST",
    "path": "/v1/events/ack",
    "signed": true,
    "pr": "M5"
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": ["ids"],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "../common.json#/$defs/uuid" }
        }
      },
      "examples": [{ "ids": ["0192b2e4-7c1a-7d3e-9f4b-2a6c8e0d1f35"] }]
    },
    "response": {
      "type": "object",
      "required": ["acknowledged"],
      "properties": { "acknowledged": { "type": "integer", "minimum": 0 } },
      "examples": [{ "acknowledged": 1 }]
    }
  }
}
