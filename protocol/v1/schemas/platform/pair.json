{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.kronixon.com/protocol/v1/schemas/platform/pair.json",
  "title": "POST /v1/pair (platform)",
  "description": "Pairing: unsigned, the one-time code is the secret (10 min, 5 attempts, 10/h per IP). The answer carries the shared secret sealed to the module's X25519 key; the platform then checks GET capabilities on store_url before the store counts as connected (Spec §3.1–§3.2, plan D4).",
  "x-kx-endpoint": {
    "method": "POST",
    "path": "/v1/pair",
    "signed": false,
    "pr": "platform B2 / M1"
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "code",
        "store_url",
        "platform",
        "version",
        "php",
        "module_version",
        "protocol",
        "public_key",
        "shop_id",
        "capabilities_hash"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789abcdefghjkmnpqrstuvwxyz]{4}-?[ABCDEFGHJKLMNPQRSTUVWXYZ23456789abcdefghjkmnpqrstuvwxyz]{4}$"
        },
        "store_url": { "$ref": "../common.json#/$defs/url" },
        "platform": { "const": "prestashop" },
        "version": { "type": "string" },
        "php": { "type": "string" },
        "module_version": { "type": "string" },
        "protocol": { "const": "v1" },
        "public_key": {
          "description": "base64 of the 32-byte X25519 public key.",
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "shop_id": { "type": "integer", "minimum": 1 },
        "shop_name": { "type": "string", "maxLength": 255 },
        "timezone": { "type": "string" },
        "capabilities_hash": { "$ref": "../common.json#/$defs/sha256" }
      },
      "examples": [
        {
          "code": "K7PM-3XQ9",
          "store_url": "https://shop.example.com/",
          "platform": "prestashop",
          "version": "8.1.7",
          "php": "8.1.29",
          "module_version": "1.0.0",
          "protocol": "v1",
          "public_key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
          "shop_id": 1,
          "shop_name": "Example Shop",
          "timezone": "Europe/Sofia",
          "capabilities_hash": "142cbfb1fbcb6e319ac89ebbb22bcd6d651ff0cba117e97f8c13338afa1f8738"
        }
      ]
    },
    "response": {
      "type": "object",
      "required": [
        "store_id",
        "shared_secret_sealed",
        "platform_public_key",
        "api_base",
        "events_url",
        "server_time",
        "heartbeat_interval"
      ],
      "properties": {
        "store_id": { "$ref": "../common.json#/$defs/uuid" },
        "shared_secret_sealed": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "platform_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "api_base": { "$ref": "../common.json#/$defs/https_url" },
        "events_url": { "$ref": "../common.json#/$defs/https_url" },
        "server_time": { "$ref": "../common.json#/$defs/unix_time" },
        "tenant_name": { "type": "string", "maxLength": 255 },
        "heartbeat_interval": { "type": "integer", "minimum": 3600 }
      },
      "examples": [
        {
          "store_id": "0192b2e4-2f7a-7c5b-8a1d-3e4f5a6b7c8d",
          "shared_secret_sealed": "c2VhbGVkLWJ5LWNyeXB0by1ib3gtc2VhbA==",
          "platform_public_key": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
          "api_base": "https://connect.kronixon.com/v1",
          "events_url": "https://connect.kronixon.com/v1/stores/0192b2e4-2f7a-7c5b-8a1d-3e4f5a6b7c8d/events",
          "server_time": 1790772000,
          "tenant_name": "Example Ltd",
          "heartbeat_interval": 86400
        }
      ]
    }
  }
}
