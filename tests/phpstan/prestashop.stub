<?php

// PrestaShop core classes the module touches, with the signatures shared by 1.7.8–9.x (PHPStan only).

class Context
{
    /** @var Cookie|null */
    public $cookie;

    /** @var Smarty */
    public $smarty;

    /** @var Link */
    public $link;

    /** @var Shop */
    public $shop;

    /** @var Language */
    public $language;

    /** @var Employee|null */
    public $employee;

    /** @return Context */
    public static function getContext() {}
}

class Shop
{
    /** @var int */
    public $id;

    /** @var string */
    public $name;

    /** @var int */
    public $id_shop_group;

    /** @var int the shop's Home category */
    public $id_category;

    /**
     * @param bool $auto_ssl
     * @param bool $add_base_uri
     * @return string|false
     */
    public function getBaseURL($auto_ssl = false, $add_base_uri = true) {}

    /** @return bool */
    public static function isFeatureActive() {}

    /**
     * @param bool $active
     * @param int|null $id_shop_group
     * @param bool $get_as_list_id
     * @return array<int, array<string, mixed>>
     */
    public static function getShops($active = true, $id_shop_group = null, $get_as_list_id = false) {}

    /** @return ShopGroup */
    public function getGroup() {}

    public const CONTEXT_SHOP = 1;
    public const CONTEXT_GROUP = 2;
    public const CONTEXT_ALL = 4;

    /** @return int|null */
    public static function getContext() {}

    /**
     * @param bool $null_value_without_multishop
     * @return int|null
     */
    public static function getContextShopID($null_value_without_multishop = false) {}

    /**
     * @param bool $null_value_without_multishop
     * @return int|null
     */
    public static function getContextShopGroupID($null_value_without_multishop = false) {}

    /**
     * @param int $type
     * @param int|null $id
     * @return void
     */
    public static function setContext($type, $id = null) {}
}

class ShopGroup
{
    /** @var bool */
