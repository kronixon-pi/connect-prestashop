    public function assign($tpl_var, $value = null, $nocache = false) {}
}

class Link
{
    /**
     * @param int $product
     * @param string|null $alias
     * @param string|null $category
     * @param string|null $ean13
     * @param int|null $idLang
     * @param int|null $idShop
     * @return string
     */
    public function getProductLink($product, $alias = null, $category = null, $ean13 = null, $idLang = null, $idShop = null) {}

    /**
     * @param int $category
     * @param string|null $alias
     * @param int|null $idLang
     * @param string|null $selectedFilters
     * @param int|null $idShop
     * @return string
     */
    public function getCategoryLink($category, $alias = null, $idLang = null, $selectedFilters = null, $idShop = null) {}

    /**
     * @param string $module
     * @param string $controller
     * @param array<string, mixed> $params
     * @param bool|null $ssl
     * @param int|null $idLang
     * @param int|null $idShop
     * @param bool $relativeProtocol
     * @return string
     */
    public function getModuleLink($module, $controller = 'default', array $params = [], $ssl = null, $idLang = null, $idShop = null, $relativeProtocol = false) {}

    /**
     * @param string $controller
     * @param bool $withToken
     * @param array<string, mixed> $sfRouteParams
     * @param array<string, mixed> $params
     * @return string
     */
    public function getAdminLink($controller, $withToken = true, $sfRouteParams = [], $params = []) {}

    /**
     * @param string $name
     * @param string $ids
     * @param string|null $type
     * @return string
     */
    public function getImageLink($name, $ids, $type = null) {}

    /**
     * @param int $idManufacturer
     * @param string|null $type
     * @return string
     */
    public function getManufacturerImageLink($idManufacturer, $type = null) {}
}

class Db
{
    /**
     * @param bool $master
     * @return Db
     */
    public static function getInstance($master = true) {}

    /**
     * @return class-string<Db>
     */
    public static function getClass() {}

    /**
     * @param string $server
     * @param string $user
     * @param string $password
     * @param string $database
     * @param bool $connect
     */
    public function __construct($server, $user, $password, $database, $connect = true) {}

    /**
     * @return void
     */
    public function disconnect() {}

    /**
     * @param string $sql
     * @param bool $use_cache
     * @return bool
     */
    public function execute($sql, $use_cache = true) {}

    /**
     * @param string $sql
     * @param bool $use_cache
     * @return string|false|null
     */
    public function getValue($sql, $use_cache = true) {}

    /**
     * @param string $sql
     * @param bool $array
     * @param bool $use_cache
     * @return array<int, array<string, mixed>>|false
     */
    public function executeS($sql, $array = true, $use_cache = true) {}

    /** @return int */
    public function Affected_Rows() {}

    /** @return int|string */
    public function Insert_ID() {}

    /** @return int */
    public function getNumberError() {}

    /**
     * @param string $string
     * @param bool $html_ok
     * @return string
     */
    public function escape($string, $html_ok = false) {}

    /** @return string */
    public function getVersion() {}
}

class Configuration
{
    /**
     * @param string $key
     * @param int|null $idLang
     * @param int|null $idShopGroup
     * @param int|null $idShop
     * @param mixed $default
     * @return string|false
     */
    public static function get($key, $idLang = null, $idShopGroup = null, $idShop = null, $default = false) {}

    /**
     * @param string $key
     * @param int|null $idLang
     * @return string|false
     */
    public static function getGlobalValue($key, $idLang = null) {}

    /**
     * @param string $key
     * @param mixed $values
     * @param bool $html
     * @param int|null $idShopGroup
     * @param int|null $idShop
     * @return bool
     */
    public static function updateValue($key, $values, $html = false, $idShopGroup = null, $idShop = null) {}

    /**
     * @param string $key
     * @param mixed $values
     * @param bool $html
     * @return bool
     */
    public static function updateGlobalValue($key, $values, $html = false) {}

    /**
     * @param string $key
     * @return bool
     */
    public static function deleteByName($key) {}
}

abstract class Module
{
    /** @var string */
    public $name;

    /** @var string */
    public $tab;

    /** @var string */
    public $version;

    /** @var string */
    public $author;

    /** @var int */
    public $need_instance;

    /** @var array<string, string> */
    public $ps_versions_compliancy;

    /** @var bool */
    public $bootstrap;

    /** @var string */
    public $displayName;

    /** @var string */
    public $description;

    /** @var string */
    public $confirmUninstall;

    /** @var list<string> */
    protected $_errors = [];

    /** @var list<array<string, mixed>> */
    public $tabs = [];

    /** @var Context */
    protected $context;

    /**
     * @param string|null $name
     * @param Context|null $context
     */
    public function __construct($name = null, $context = null) {}

    /** @return bool */
    public function install() {}

    /** @return bool */
    public function uninstall() {}

    /**
     * @param string $string
     * @param string|false $specific
     * @param string|null $locale
     * @return string
     */
    public function l($string, $specific = false, $locale = null) {}

    /**
     * @param string|array<int, string> $hook_name
     * @param array<int, int>|null $shop_list
     * @return bool
     */
    public function registerHook($hook_name, $shop_list = null) {}

    /**
     * @param int $id_hook
     * @param bool $way
     * @param int|null $position
     * @return bool
     */
    public function updatePosition($id_hook, $way, $position = null) {}

    /**
     * @param string $hook
     * @return bool
     */
    public function isRegisteredInHook($hook) {}

    /**
     * @param string $file
     * @param string $template
     * @param string|null $cache_id
     * @param string|null $compile_id
     * @return string
     */
    public function display($file, $template, $cache_id = null, $compile_id = null) {}

    /**
     * @param string $module_name
     * @return bool
     */
    public static function isEnabled($module_name) {}

    /**
     * @param string $module_name
     * @return Module|false
     */
    public static function getInstanceByName($module_name) {}
}

class FrontController
{
    /** @var Context */
