class PhpEncryption
{
    /** @param string $hexString */
    public function __construct($hexString) {}

    /**
     * @param string $plaintext
     * @return string
     */
    public function encrypt($plaintext) {}

    /**
     * @param string $cipherText
     * @return string|false
     */
    public function decrypt($cipherText) {}
}

abstract class ObjectModel
{
    /** @var int|null */
    public $id;

    /**
     * @param int|null $id
     */
    public function __construct($id = null) {}

    /**
     * @param bool $auto_date
     * @param bool $null_values
     * @return bool
     */
    public function add($auto_date = true, $null_values = false) {}

    /**
     * @param bool $null_values
     * @return bool
     */
    public function update($null_values = false) {}

    /** @return bool */
    public function delete() {}

    /**
     * @param array<string, bool|array<int, bool>>|null $fields
     * @return void
     */
    public function setFieldsToUpdate($fields) {}

    /**
     * @param bool $die
     * @param bool $error_return
     * @return bool|string
     */
    public function validateFields($die = true, $error_return = false) {}

    /**
     * @param bool $die
     * @param bool $error_return
     * @return bool|string
     */
    public function validateFieldsLang($die = true, $error_return = false) {}

    /**
     * @param string $field
     * @param mixed $value
     * @param int|null $id_lang
     * @return bool|string
     */
    public function validateField($field, $value, $id_lang = null) {}

    /**
     * @param string|ObjectModel $class
     * @return array<string, mixed>
     */
    public static function getDefinition($class) {}
}

class Profile extends ObjectModel
{
    /** @var array<int, string>|string */
    public $name;
}

class Employee extends ObjectModel
{
    /** @var string */
    public $firstname;

    /** @var string */
    public $lastname;

    /** @var string */
    public $email;

    /** @var string */
    public $passwd;

    /** @var int */
    public $id_profile;

    /** @var int */
    public $id_lang;

    /** @var bool */
    public $active;
}

class Tools
{
    /**
     * @param string $submit
     * @return bool
     */
    public static function isSubmit($submit) {}

    /**
     * @param string $key
     * @param mixed $default_value
     * @return mixed
     */
    public static function getValue($key, $default_value = false) {}

    /**
     * @param string $url
     * @return void
     */
    public static function redirectAdmin($url) {}

    /**
     * @param string $url
     * @param string $base_uri
     * @param Link|null $link
     * @param list<string>|null $headers
     * @return void
     */
    public static function redirect($url, $base_uri = '/', $link = null, $headers = null) {}

    /**
     * @param int|false $id_product
     * @return void
     */
    public static function clearColorListCache($id_product = false) {}

    /**
     * @param string $html
     * @return string
     */
    public static function purifyHTML($html) {}

    /**
     * @param string $str
     * @return string|false
     */
    public static function str2url($str) {}

    /** @return void */
    public static function clearSmartyCache() {}

    /** @return void */
    public static function clearAllCache() {}
}

